---
import Base from '../layouts/Base.astro';
import PerkCard from '../components/PerkCard.astro';
import { RARITY_NAME, loadPerks } from '../lib/perks';
import { loadSets, setsByType } from '../lib/sets';
import { href } from '../lib/url';

const sets = loadSets();
const perks = loadPerks();
const byType = setsByType(sets);

const owned = (type: string) => perks.filter((perk) => perk.setTypes.includes(type));
const typeless = perks.filter((perk) => perk.setTypes.length === 0);
---
<Base title="세트 — SharedFate" description={`SharedFate 의 세트 ${sets.length}유형과 단계별 효과 전체 표.`}>
  <div class="wrap">
    <h1>세트</h1>
    <p class="lead">
      증강마다 유형이 붙어 있습니다. 같은 유형을 모을 때마다 추가 보상이 켜지고{' '}
      <b>단계는 누적됩니다.</b> 유형은 {sets.length}가지이고, 유형이 없는 증강이 {typeless.length}개입니다.
      원리는 <a href={href('/guide/sets')}>가이드</a>에 있습니다.
    </p>

    <h2>한눈에</h2>
    <table>
      <thead>
        <tr><th>유형</th><th>가진 증강</th><th>열리는 개수</th></tr>
      </thead>
      <tbody>
        {sets.map((set) => (
          <tr>
            <td><a href={`#${set.type}`}>{set.name}</a></td>
            <td>{owned(set.type).length}</td>
            <td>{set.tiers.map((tier) => tier.count).join(' · ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="muted note">
      한 증강이 유형을 둘 가질 수 있어 「가진 증강」의 합은 {perks.length}보다 큽니다.
    </p>

    {sets.map((set) => (
      <section id={set.type}>
        <h2>{set.name}</h2>
        <ol class="tiers">
          {set.tiers.map((tier) => (
            <li><span class="count">{tier.count}개</span><span>{tier.description}</span></li>
          ))}
        </ol>
        <ul class="members">
          {owned(set.type).map((perk) => (
            <>
              <li class="member" data-rarity={perk.rarity}>
                <button type="button" class="pick" aria-expanded="false" data-perk={`${set.type}:${perk.id}`}>
                  <b>{perk.name}</b>
                  <span class="muted">{RARITY_NAME[perk.rarity]}</span>
                </button>
              </li>
              <li class="drawer" data-for={`${set.type}:${perk.id}`} hidden>
                <PerkCard perk={perk} sets={byType} />
              </li>
            </>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .lead { color: var(--muted); max-width: var(--measure); }
  .note { font-size: 0.85rem; }

  section { border-top: 1px solid var(--border); padding-top: 0.4rem; margin-top: 2rem; }

  .tiers { list-style: none; margin: 0.6rem 0 1rem; padding: 0; max-width: var(--measure); }
  .tiers li { display: flex; gap: 0.7rem; color: var(--muted); }
  .tiers li + li { margin-top: 0.3rem; }
  .count { flex: none; width: 2.6rem; color: var(--accent); font-size: 0.88rem; }

  .members {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0.45rem;
    align-items: start;
  }

  .member {
    background: var(--panel);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border-strong);
    border-radius: var(--radius);
  }
  .member[data-rarity='silver'] { border-left-color: var(--silver); }
  .member[data-rarity='gold'] { border-left-color: var(--gold); }
  .member[data-rarity='prism'] { border-left-color: var(--prism); }

  .pick {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    width: 100%;
    font: inherit;
    font-size: 0.86rem;
    color: var(--text);
    background: transparent;
    border: 0;
    border-radius: var(--radius);
    padding: 0.3rem 0.6rem;
    cursor: pointer;
    text-align: left;
  }
  .pick:hover { color: var(--accent-text); }
  .pick:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .pick[aria-expanded='true'] { color: var(--accent-text); background: var(--accent-soft); }
  .pick .muted { font-size: 0.75rem; margin-left: auto; }

  /* 펼침 칸은 한 줄을 통째로 쓴다. 격자가 이것을 눌린 이름 바로 다음 줄에 놓는다. */
  .drawer {
    grid-column: 1 / -1;
    max-width: 24rem;
    padding: 0.2rem 0 0.5rem;
  }
  .drawer[hidden] { display: none; }
</style>

<script>
  const closeAll = (exceptKey?: string) => {
    for (const drawer of document.querySelectorAll<HTMLElement>('.drawer')) {
      if (drawer.dataset.for === exceptKey) continue;
      drawer.hidden = true;
    }
    for (const pick of document.querySelectorAll<HTMLElement>('.pick')) {
      if (pick.dataset.perk === exceptKey) continue;
      pick.setAttribute('aria-expanded', 'false');
    }
  };

  document.addEventListener('click', (event) => {
    const pick = (event.target as Element | null)?.closest('.pick') as HTMLElement | null;
    if (!pick) return;

    const key = pick.dataset.perk;
    const drawer = document.querySelector<HTMLElement>(`.drawer[data-for="${key}"]`);
    if (!drawer) return;

    const opening = drawer.hidden;
    closeAll(opening ? key : undefined);
    drawer.hidden = !opening;
    pick.setAttribute('aria-expanded', String(opening));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAll();
  });
</script>
