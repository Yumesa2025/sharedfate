---
import SetName from "./SetName.astro";
import type { PerkSet } from '../lib/sets';

interface Props {
  set: PerkSet;
}

const { set } = Astro.props;
---
<div class="tag" data-type={set.type}>
  <button type="button" class="label" aria-expanded="false"><SetName type={set.type} name={set.name} /></button>
  <div class="pop">
    <div class="pop-head">
      <b><SetName type={set.type} name={set.name} /></b>
      <span class="muted">{set.opensAt}개부터 열립니다</span>
    </div>
    <ul>
      {set.tiers.map((tier) => (
        <li>
          <span class="count">{tier.count}</span>
          <span>{tier.description}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /*
   * <details> 로 만들면 안 된다. 닫힌 <details> 는 Chromium 이 안쪽을 감춰서,
   * 호버할 때 display:block 을 줘도 실제로는 그려지지 않는다 (크기가 0×0 으로 남는다).
   * 그래서 열고 닫는 것을 visibility 로 한다 — 마우스는 :hover, 키보드와 터치는
   * :focus-within, 그리고 스크립트가 있으면 눌러서 고정할 수 있게 .open 이 붙는다.
   * 스크립트가 꺼져 있어도 앞의 둘은 그대로 동작한다.
   */
  .tag { position: relative; display: inline-block; }

  /*
   * 게임에서는 유형이 그냥 한 줄 글자다(TEXT_SET_TYPE = #8FB8C8). 그 모습을 지키되,
   * 눌러서 세트 단계를 펼 수 있다는 것은 보여야 하므로 점선 밑줄을 하나 깐다.
   */
  .label {
    font: inherit;
    font-size: 0.78rem;
    line-height: 1.5;
    color: #8fb8c8;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline dotted;
    text-underline-offset: 0.2em;
    text-decoration-color: rgba(143, 184, 200, 0.5);
  }
  .tag:hover > .label,
  .tag:focus-within > .label,
  .tag.open > .label {
    color: #bfe2ef;
    text-decoration-color: currentColor;
  }
  .label:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

  .pop {
    /*
     * 닫혔을 때는 display: none 이어야 한다. visibility 로 감추면 보이지만 않을 뿐
     * 자리는 그대로 차지해서, 카드 가운데 있는 이름표의 오버레이가 오른쪽으로 삐져나가고
     * 좁은 화면에 가로 스크롤이 생긴다. <details> 를 쓸 때는 display 를 못 썼지만
     * 지금은 평범한 div 라 써도 된다.
     */
    display: none;
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    left: 0;
    /*
     * 언제나 이름표의 왼쪽에 맞춰 편다. 「오른쪽 끝이면 오른쪽에 맞춘다」로 두면
     * 좁은 화면에서 오버레이가 왼쪽 화면 밖으로 밀려난다.
     * 폭은 화면 너비에서 좌우 여백을 뺀 값으로 묶어 둔다.
     */
    min-width: min(17rem, calc(100vw - 2.6rem));
    max-width: min(24rem, calc(100vw - 2.6rem));
    background: #161A22;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55);
    padding: 0.7rem 0.8rem;
    text-align: left;
  }
  .tag:hover > .pop,
  .tag:focus-within > .pop,
  .tag.open > .pop {
    display: block;
  }

  .pop-head { display: flex; align-items: baseline; gap: 0.5rem; }
  .pop-head .muted { font-size: 0.75rem; }

  ul { list-style: none; margin: 0.55rem 0 0; padding: 0.55rem 0 0; border-top: 1px solid var(--border); }
  li { display: flex; gap: 0.55rem; font-size: 0.83rem; line-height: 1.6; color: var(--muted); }
  li + li { margin-top: 0.35rem; }
  .count { flex: none; width: 1rem; text-align: right; color: var(--accent); }
</style>

<script>
  /*
   * 오버레이를 화면 안으로 당긴다.
   *
   * CSS 만으로는 이름표가 카드 안에서 가로로 어디쯤인지 알 수 없어, 좁은 화면에서
   * 둘째·셋째 이름표의 오버레이가 오른쪽으로 삐져나간다. 그래서 열릴 때마다 재서
   * 넘친 만큼 왼쪽으로 민다. 스크립트가 꺼져 있으면 왼쪽 정렬 그대로인데,
   * 마우스가 있는 넓은 화면에서는 그것으로 충분하다.
   */
  const MARGIN = 8;

  const place = (tag: Element) => {
    const pop = tag.querySelector<HTMLElement>('.pop');
    if (!pop) return;

    pop.style.left = '0px';
    const room = document.documentElement.clientWidth;

    const over = pop.getBoundingClientRect().right - (room - MARGIN);
    if (over > 0) pop.style.left = `${-over}px`;

    const short = MARGIN - pop.getBoundingClientRect().left;
    if (short > 0) pop.style.left = `${Number.parseFloat(pop.style.left) + short}px`;
  };

  // 호버로 열리는 것도 같이 보정한다.
  document.addEventListener('mouseover', (event) => {
    const tag = (event.target as Element | null)?.closest('.tag');
    if (tag) place(tag);
  });

  // 이름표를 눌러 고정해 두는 것. 없어도 호버와 포커스로 열리므로 순전히 덤이다.
  const closeAll = (except?: Element) => {
    for (const tag of document.querySelectorAll('.tag.open')) {
      if (tag === except) continue;
      tag.classList.remove('open');
      tag.querySelector('.label')?.setAttribute('aria-expanded', 'false');
    }
  };

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    const label = target?.closest('.tag > .label') as HTMLElement | null;
    const tag = label?.parentElement;

    closeAll(tag ?? undefined);
    if (!label || !tag) return;

    const opening = !tag.classList.contains('open');
    tag.classList.toggle('open', opening);
    label.setAttribute('aria-expanded', String(opening));
    if (opening) place(tag);
  });

  // 키보드로 옮겨 다닐 때도 보정한다.
  document.addEventListener('focusin', (event) => {
    const tag = (event.target as Element | null)?.closest('.tag');
    if (tag) place(tag);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAll();
  });
</script>
