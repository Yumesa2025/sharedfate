{
  "schemaVersion": 1,
  "id": "sharedfate",
  "version": "${version}",
  "name": "SharedFate",
  "description": "체력 하나, 인벤토리 하나로 최대 네 명이 엔더 드래곤을 잡는 협동 로그라이크. 전멸하면 월드가 사라지고 새 월드에서 다음 회차가 시작된다. 레벨이 오를 때마다 증강을 하나씩 골라 회차마다 다른 몸이 된다.",
  "authors": ["Yumesa2025"],
  "contact": {
    "homepage": "https://yumesa2025.github.io/sharedfate/"
  },
  "license": "MIT",
  "icon": "assets/sharedfate/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.sharedfate.SharedFateMod"
    ],
    "client": [
      "com.sharedfate.client.SharedFateClient"
    ]
  },
  "mixins": [
    "sharedfate.mixins.json",
    {
      "config": "sharedfate.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.161.0+26.3"
  }
}
